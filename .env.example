# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_DB=datavello
POSTGRES_USER=datavello
POSTGRES_PASSWORD=change-me
# Host port. Use 5433 if a native PostgreSQL is already listening on 5432.
POSTGRES_PORT=5432

# --- Backend (ASP.NET Core reads these in Development via the .env loader) ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=datavello;Username=datavello;Password=change-me
# Separate database used by integration tests (recreated on every test run).
ConnectionStrings__Test=Host=localhost;Port=5432;Database=datavello_test;Username=datavello;Password=change-me
